// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  username  String   @unique
  password  String
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  status    String // Active, Pending, Inactive
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id          String           @id
  name        String           @unique
  description String?
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id
  label       String
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model Branch {
  id        String   @id
  name      String   @unique
  location  String
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Merchant {
  id              String        @id
  name            String
  branch          String
  status          String // Approved, Pending, Rejected
  onboardingDate  DateTime
  operatorCount   Int
  operators       Operator[]
  transactions    Transaction[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Operator {
  id               String        @id
  name             String
  merchantId       String
  merchant         Merchant      @relation(fields: [merchantId], references: [id])
  branch           String
  salesVolume      Float
  transactionCount Int
  successRate      Float
  status           String // Active, Inactive, Blocked
  bankAccount      String        @unique
  transactions     Transaction[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Transaction {
  id         String   @id
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id])
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id])
  amount     Float
  status     String // Completed, Pending, Failed, Reconciled
  type       String // IPS_QR, OTP
  date       DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// For merchant onboarding approval workflow
model WorkflowStep {
  id          String   @id // e.g., 'compliance', 'management'
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  onboardingWorkflows OnboardingWorkflow[]
}

model OnboardingWorkflow {
  id      Int @id @default(autoincrement())
  stepId  String
  step    WorkflowStep @relation(fields: [stepId], references: [id])
  order   Int
  
  @@unique([stepId, order])
}
